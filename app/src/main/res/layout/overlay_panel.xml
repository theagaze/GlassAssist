<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
        O padding de overscan é aplicado em código com o mesmo valor usado na janela.
        Ele impede que o vidro, o brilho da borda ou a bolinha em escala reduzida
        sejam cortados quando o painel estiver perto de uma borda da tela.
    -->
    <com.glassassist.service.PanelGlassView
        android:id="@+id/panelGlass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:glassMaterial="clear"
        app:cornerRadius="34dp"
        app:bevelWidth="20dp"
        app:refractionHeight="64dp"
        app:dispersionStrength="0.16">

        <LinearLayout
            android:id="@+id/panelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <com.glassassist.service.PagesContainer
                android:id="@+id/pagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <GridLayout
                    android:id="@+id/pageZero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:useDefaultMargins="false" />

                <GridLayout
                    android:id="@+id/pageOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:useDefaultMargins="false"
                    android:alpha="0" />
            </com.glassassist.service.PagesContainer>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pagePrev"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:alpha="0.78"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_chevron_left" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/pageNext"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:alpha="0.78"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </com.glassassist.service.PanelGlassView>
</FrameLayout>
